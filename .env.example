# 管理者パスワード（テンプレート上書き・/api/auth）
ADMIN_PASSWORD=change-me-in-production

# ローカルサーバー（省略時 3847）
# PORT=3847

# OpenAI（/generate で使用。フロントには出しません）
OPENAI_API_KEY=sk-your-key-here
# 省略時は gpt-4.1-mini
# OPENAI_MODEL=gpt-4.1-mini

# CORS: フロントのオリジンをカンマ区切り（末尾スラッシュなし）
# 例: http://localhost:3847,http://127.0.0.1:3847
ALLOWED_ORIGINS=http://localhost:3847,http://127.0.0.1:3847

# Supabase（LP保存 / 公開URL用）
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
